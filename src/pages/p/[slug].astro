---
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Clip from '../../components/Clip.astro';
import ProjectLink from '../../components/ProjectLink.astro';
import { getProjects, builtLabel, unitLabel, AREA_LABEL, type Project } from '../../lib/projects';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((p, i) => ({
    params: { slug: p.id },
    props: { project: p, index: i, prev: projects[i - 1], next: projects[i + 1] },
  }));
}

interface Props {
  project: Project;
  index: number;
  prev?: Project;
  next?: Project;
}

const { project, index, prev, next } = Astro.props;
const { data } = project;
const { Content } = await render(project);
---

<Layout title={`${data.name} · scottsbots`} description={data.tagline}>
  <main>
    <a href="/" class="label mt-8 inline-block hover:text-ink">← All units</a>

    <p class="label mt-10">{unitLabel(index)}</p>
    <h1 class="dot mt-3 text-[clamp(2.2rem,7vw,3.8rem)]">{data.name}</h1>
    <p class="mt-5 max-w-2xl text-lg leading-relaxed">{data.tagline}</p>

    <div class="mt-10">
      <Clip src={data.clip} poster={data.poster} name={data.name} mode="play" />
    </div>

    <div class="mt-12 grid gap-12 lg:grid-cols-[1fr_17rem]">
      <article class="prose-bot max-w-2xl">
        <Content />
      </article>
      <div class="h-fit">
        <dl class="border-t border-l border-line text-sm">
          <div class="flex justify-between gap-4 border-r border-b border-line px-3 py-2">
            <dt class="label">Built</dt>
            <dd>{builtLabel(data.built)}</dd>
          </div>
          <div class="flex justify-between gap-4 border-r border-b border-line px-3 py-2">
            <dt class="label">Area</dt>
            <dd>{AREA_LABEL[data.area]}</dd>
          </div>
          <div class="border-r border-b border-line px-3 py-2">
            <dt class="label">Stack</dt>
            <dd class="mt-1 leading-relaxed">{data.stack.join(' / ')}</dd>
          </div>
        </dl>
        <div class="mt-5">
          <ProjectLink link={data.link} />
        </div>
      </div>
    </div>

    <nav class="label mt-20 flex justify-between gap-6 border-t border-line pt-4">
      {prev ? <a href={`/p/${prev.id}/`} class="hover:text-ink">← {prev.data.name}</a> : <span />}
      {next && <a href={`/p/${next.id}/`} class="text-right hover:text-ink">{next.data.name} →</a>}
    </nav>
  </main>
</Layout>
