---
import Layout from '../layouts/Layout.astro';
import { LINKEDIN_URL, SINCE_2021, EXPERIENCE, EDUCATION } from '../data/resume';
---

<Layout
  title="Resume · Scott Neil"
  description="Scott Neil: ML and product work at Facebook, contract startup work, investing and the tools on scottsbots."
>
  <main class="resume">
    <section class="pt-10 pb-12 print:pt-0 print:pb-5">
      <h1 class="dot text-[clamp(2.4rem,8vw,4.4rem)]">Scott Neil</h1>
      <p class="mt-3 max-w-2xl leading-relaxed">
        Product manager and data scientist at Facebook and Instagram for 7 years. Since 2021, building tools, doing contract ML work and trading.
      </p>
      <p class="label mt-5 flex flex-wrap gap-x-6 gap-y-2">
        <a href={LINKEDIN_URL} class="hover:text-ink">LinkedIn ↗</a>
        <a href="/" class="hover:text-ink print:hidden">Projects →</a>
        <span class="hidden print:inline">scottsbots.vercel.app</span>
      </p>
    </section>

    <section class="border-t border-line pt-3">
      <h2 class="label">Since 2021</h2>
      <ul class="mt-4 border-t border-line print:mt-2">
        {
          SINCE_2021.map((s) => (
            <li class="grid gap-1 border-b border-line py-3 print:py-1.5 sm:grid-cols-[13rem_1fr] sm:gap-6">
              <span class="font-semibold">{s.label}</span>
              <span class="leading-relaxed">{s.text}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="mt-14 border-t border-line pt-3 print:mt-6">
      <h2 class="label">Experience</h2>
      {
        EXPERIENCE.map((e) => (
          <article class="job mt-8 print:mt-4">
            <header class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
              <h3 class="dot text-[1.6rem]">{e.org}</h3>
              <p class="label">
                {e.dates}
                {e.place && <span> · {e.place}</span>}
              </p>
            </header>
            {e.roles.map((r) => (
              <div class="role mt-5 border-l border-line pl-4 sm:pl-6 print:mt-2">
                <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
                  <p>
                    <span class="font-semibold">{r.title}</span>
                    {r.team && <span class="text-dim"> · {r.team}</span>}
                  </p>
                  <p class="label">{r.dates}</p>
                </div>
                <ul class="bullets mt-2">
                  {r.bullets.map((b) => (
                    <li>{b}</li>
                  ))}
                </ul>
              </div>
            ))}
          </article>
        ))
      }
    </section>

    <section class="mt-14 border-t border-line pt-3 print:mt-6">
      <h2 class="label">Education</h2>
      <div class="mt-5 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
        <p>
          <span class="font-semibold">{EDUCATION.school}</span>
          <span class="text-dim"> · {EDUCATION.degree}</span>
        </p>
        <p class="label">{EDUCATION.dates}</p>
      </div>
    </section>
  </main>
</Layout>

<style>
  .bullets li {
    position: relative;
    padding: 0.3rem 0 0.3rem 1.25rem;
    line-height: 1.55;
  }

  @media print {
    .bullets li {
      padding-block: 0.1rem;
    }
  }

  .bullets li::before {
    content: ">";
    position: absolute;
    left: 0.1rem;
    color: var(--dim);
  }

  @media print {
    .role {
      break-inside: avoid;
    }

    .job header {
      break-after: avoid;
    }
  }
</style>
