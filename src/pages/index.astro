---
import Layout from '../layouts/Layout.astro';
import Clip from '../components/Clip.astro';
import ProjectLink from '../components/ProjectLink.astro';
import { getProjects, unitLabel, AREA_LABEL } from '../lib/projects';

const projects = await getProjects();
---

<Layout
  title="scottsbots"
  description="Tools Scott created to help him get stuff done, with a short clip of each one running."
>
  <main>
    <section class="pt-16 pb-14">
      <h1 class="dot text-[clamp(2.6rem,9vw,5rem)]">scottsbots</h1>
      <p class="mt-2 max-w-xl leading-relaxed">Tools I’ve created to help me get stuff done.</p>
    </section>

    <ol class="grid gap-x-10 gap-y-16 lg:grid-cols-2">
      {
        projects.map((p, i) => (
          <li class:list={['group relative border-t border-line pt-3', p.data.featured && 'lg:col-span-2']}>
            <p class="label flex justify-between">
              <span>{unitLabel(i)}</span>
              <span>{AREA_LABEL[p.data.area]}</span>
            </p>
            <div class:list={['mt-3', p.data.featured && 'lg:grid lg:grid-cols-[minmax(0,2fr)_minmax(0,1fr)] lg:gap-10']}>
              <Clip src={p.data.clip} poster={p.data.poster} name={p.data.name} />
              <div>
                <h2 class:list={['dot mt-5 text-[1.7rem]', p.data.featured && 'lg:mt-0 lg:text-[2.6rem]']}>
                  <a href={`/p/${p.id}/`} class="after:absolute after:inset-0 after:content-[''] group-hover:underline group-hover:decoration-2 group-hover:underline-offset-4">
                    {p.data.name}
                  </a>
                </h2>
                <p class:list={['mt-3 leading-relaxed', p.data.featured && 'lg:text-lg']}>{p.data.tagline}</p>
                <p class="label mt-3 normal-case tracking-normal">{p.data.stack.join(' / ')}</p>
                <div class="mt-5">
                  <ProjectLink link={p.data.link} />
                </div>
              </div>
            </div>
          </li>
        ))
      }
    </ol>
  </main>
</Layout>
