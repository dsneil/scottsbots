---
interface Props {
  src?: string;
  poster?: string;
  name: string;
}

const { src, poster, name } = Astro.props;
---

<div class="clip relative aspect-[16/10] overflow-hidden border border-line bg-panel">
  {
    src ? (
      <video
        class="h-full w-full object-cover"
        src={src}
        poster={poster}
        muted
        loop
        playsinline
        autoplay
        preload="metadata"
        aria-label={`Demo of ${name}`}
      />
    ) : (
      <div class="scan flex h-full w-full items-center justify-center">
        <span class="label">No signal</span>
      </div>
    )
  }
</div>

<style>
  .scan {
    background-image: repeating-linear-gradient(
      to bottom,
      transparent 0 3px,
      color-mix(in srgb, var(--ink) 6%, transparent) 3px 4px
    );
  }
</style>

<script>
  // Reduced motion: stop autoplay and hand control to the viewer.
  if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll<HTMLVideoElement>('.clip video').forEach((v) => {
      v.pause();
      v.removeAttribute('autoplay');
      v.controls = true;
    });
  }
</script>
