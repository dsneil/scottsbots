---
interface Props {
  src?: string;
  poster?: string;
  name: string;
}

const { src, poster, name } = Astro.props;
---

<div class="clip relative aspect-[16/10] overflow-hidden border border-line bg-panel">
  {
    src ? (
      <video
        class="h-full w-full object-cover"
        src={src}
        poster={poster}
        muted
        loop
        playsinline
        autoplay
        preload="metadata"
        aria-label={`Demo of ${name}`}
      />
    ) : (
      <div class="scan flex h-full w-full items-center justify-center">
        <span class="label">No signal</span>
      </div>
    )
  }
</div>

<style>
  .scan {
    background-image: repeating-linear-gradient(
      to bottom,
      transparent 0 3px,
      color-mix(in srgb, var(--ink) 6%, transparent) 3px 4px
    );
  }
</style>

<script>
  const videos = document.querySelectorAll<HTMLVideoElement>('.clip video');
  if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
    // Reduced motion: stop autoplay and hand control to the viewer.
    videos.forEach((v) => {
      v.pause();
      v.removeAttribute('autoplay');
      v.controls = true;
    });
  } else {
    // Play only while on screen; also covers browsers that skip the autoplay attribute.
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        const v = e.target as HTMLVideoElement;
        if (e.isIntersecting) v.play().catch(() => (v.controls = true));
        else v.pause();
      }
    });
    videos.forEach((v) => io.observe(v));
  }
</script>
