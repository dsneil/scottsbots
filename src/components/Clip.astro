---
interface Props {
  src?: string;
  poster?: string;
  /** Vertical crop of the still, e.g. "45%"; defaults to the top. */
  posterY?: string;
  name: string;
  /** still = poster only (index cards); play = the video, started on arrival (project page). */
  mode?: 'still' | 'play';
}

const { src, poster, posterY = 'top', name, mode = 'still' } = Astro.props;
---

{
  mode === 'play' && src ? (
    <div class="clip mx-auto w-fit max-w-full border border-line bg-panel">
      <video
        class="block h-auto max-h-[85vh] w-auto max-w-full"
        src={src}
        poster={poster}
        muted
        loop
        playsinline
        controls
        preload="metadata"
        aria-label={`Demo of ${name}`}
      />
    </div>
  ) : (
    <div class="relative aspect-[16/10] overflow-hidden border border-line bg-panel">
      {poster ? (
        <img
          class="h-full w-full object-cover"
          style={`object-position: center ${posterY}`}
          src={poster}
          alt={`${name} screenshot`}
          loading="lazy"
          decoding="async"
        />
      ) : (
        <div class="scan flex h-full w-full items-center justify-center">
          <span class="label">No signal</span>
        </div>
      )}
    </div>
  )
}

<style>
  .scan {
    background-image: repeating-linear-gradient(
      to bottom,
      transparent 0 3px,
      color-mix(in srgb, var(--ink) 6%, transparent) 3px 4px
    );
  }
</style>

<script>
  // Start the demo when the project page opens, unless the viewer asked for reduced motion.
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll<HTMLVideoElement>('.clip video').forEach((v) => {
      v.play().catch(() => {});
    });
  }
</script>
