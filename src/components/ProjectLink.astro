---
import type { Project } from '../lib/projects';

interface Props {
  link: Project['data']['link'];
}

const { link } = Astro.props;
---

{
  link.kind === 'live' || link.kind === 'code' ? (
    <span class="flex flex-wrap items-center gap-x-4 gap-y-2">
      <a href={link.url} class="btn relative z-10">
        {link.kind === 'live' ? 'Open app' : 'View code'} ↗
      </a>
      <span class="label flex items-center gap-2">
        {link.kind === 'live' && <span class="led" aria-hidden="true" />}
        {link.kind === 'live' ? 'Online' : 'Source'}
        {link.note && <span>· {link.note}</span>}
      </span>
    </span>
  ) : (
    <span class="label">{link.kind === 'soon' ? 'Code going public soon' : (link.note ?? 'Clip only')}</span>
  )
}
